NODE_ENV=development
PORT=4000

DATABASE_URL="postgresql://sentinel:sentinel@localhost:5432/sentinel_africa?schema=public"

JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

CLIENT_ORIGIN=http://localhost:5173

# Comma-separated list of API keys agents use to push offline-buffered events
AGENT_API_KEYS=dev-agent-key-1
