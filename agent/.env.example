SERVER_URL=http://localhost:4000
AGENT_API_KEY=dev-agent-key-1

# Asset this agent is watching (must already exist in Sentinel Africa, or leave blank)
ASSET_ID=

# How often to generate a synthetic local event, in ms
COLLECT_INTERVAL_MS=4000

# How often to attempt flushing the local queue to the server, in ms
SYNC_INTERVAL_MS=10000

# Path to the local durable queue file
QUEUE_FILE=./data/queue.jsonl
